from nautilus_trader.trading.strategy import Strategy as Strategy

class BBMeanReversionConfig(StrategyConfig, frozen=True):
    instrument_id: InstrumentId
    bar_type: BarType
    trade_size: Decimal
    bb_period: PositiveInt = ...
    bb_std: PositiveFloat = ...
    rsi_period: PositiveInt = ...
    rsi_buy_threshold: float = ...
    rsi_sell_threshold: float = ...
    close_positions_on_stop: bool = ...

class BBMeanReversion(Strategy):
    instrument: Instrument
    bb: Incomplete
    rsi: Incomplete
    def __init__(self, config: BBMeanReversionConfig) -> None: ...
    def on_start(self) -> None: ...
    def on_bar(self, bar: Bar) -> None: ...
    def buy(self) -> None: ...
    def sell(self) -> None: ...
    def on_data(self, data: Data) -> None: ...
    def on_event(self, event: Event) -> None: ...
    def on_stop(self) -> None: ...
    def on_reset(self) -> None: ...
    def on_save(self) -> dict[str, bytes]: ...
    def on_load(self, state: dict[str, bytes]) -> None: ...
    def on_dispose(self) -> None: ...

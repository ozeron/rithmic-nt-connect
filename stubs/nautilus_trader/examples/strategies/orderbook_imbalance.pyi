from nautilus_trader.model.instruments import Instrument as Instrument
from nautilus_trader.model.objects import Quantity as Quantity
from nautilus_trader.trading.strategy import Strategy as Strategy

class OrderBookImbalanceConfig(StrategyConfig, frozen=True):
    instrument_id: InstrumentId
    max_trade_size: Decimal
    trigger_min_size: PositiveFloat = ...
    trigger_imbalance_ratio: PositiveFloat = ...
    min_seconds_between_triggers: NonNegativeFloat = ...
    book_type: str | BookType = ...
    use_quote_ticks: bool = ...
    dry_run: bool = ...

class OrderBookImbalance(Strategy):
    instrument: Instrument | None
    book_type: BookType | None
    def __init__(self, config: OrderBookImbalanceConfig) -> None: ...
    def on_start(self) -> None: ...
    def on_order_book_deltas(self, deltas: OrderBookDeltas) -> None: ...
    def on_quote_tick(self, tick: QuoteTick) -> None: ...
    def check_trigger(self) -> None: ...
    def on_reset(self) -> None: ...
    def on_stop(self) -> None: ...

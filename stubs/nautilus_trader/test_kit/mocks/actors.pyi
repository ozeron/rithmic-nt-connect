from nautilus_trader.model.events import OrderCanceled as OrderCanceled, OrderFilled as OrderFilled
from nautilus_trader.model.instruments import Instrument as Instrument

class MockActorConfig(ActorConfig, frozen=True):
    component_id: str = ...

class MockActor(Actor):
    store: list[object]
    calls: list[str]
    def __init__(self, config: ActorConfig | None = None) -> None: ...
    def on_save(self) -> dict: ...
    def on_start(self) -> None: ...
    def on_stop(self) -> None: ...
    def on_resume(self) -> None: ...
    def on_reset(self) -> None: ...
    def on_dispose(self) -> None: ...
    def on_degrade(self) -> None: ...
    def on_fault(self) -> None: ...
    def on_instrument(self, instrument: Instrument) -> None: ...
    def on_instruments(self, instruments: list[Instrument]) -> None: ...
    def on_quote_tick(self, tick: QuoteTick) -> None: ...
    def on_trade_tick(self, tick: TradeTick) -> None: ...
    def on_bar(self, bar: Bar) -> None: ...
    def on_data(self, data: Data) -> None: ...
    def on_signal(self, signal: Data) -> None: ...
    def on_strategy_data(self, data: Data) -> None: ...
    def on_event(self, event: Event) -> None: ...
    def on_order_filled(self, event: OrderFilled) -> None: ...
    def on_order_canceled(self, event: OrderCanceled) -> None: ...


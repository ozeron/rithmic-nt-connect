from nautilus_trader.common.config import DatabaseConfig as DatabaseConfig, NautilusConfig as NautilusConfig, PositiveInt as PositiveInt

class CacheConfig(NautilusConfig, frozen=True):
    database: DatabaseConfig | None = ...
    encoding: str = ...
    timestamps_as_iso8601: bool = ...
    persist_account_events: bool = ...
    buffer_interval_ms: PositiveInt | None = ...
    bulk_read_batch_size: PositiveInt | None = ...
    use_trader_prefix: bool = ...
    use_instance_id: bool = ...
    flush_on_start: bool = ...
    drop_instruments_on_reset: bool = ...
    tick_capacity: PositiveInt = ...
    bar_capacity: PositiveInt = ...

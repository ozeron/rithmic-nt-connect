    retry_delay_max_ms: PositiveInt | None = ...
    recv_window_ms: PositiveInt | None = ...
    update_instruments_interval_mins: PositiveInt | None = ...
    max_requests_per_second: PositiveInt = ...
    max_requests_per_minute: PositiveInt = ...


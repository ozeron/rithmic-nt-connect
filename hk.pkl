amends "package://github.com/jdx/hk/releases/download/v1.55.0/hk@1.55.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.55.0/hk@1.55.0#/Builtins.pkl"

// ruff/ty run via `uv run` (they live in the venv). The exclude mirrors
// [tool.ruff]: hk passes explicit paths, so ruff's own exclude is bypassed.
local ruff_globs = List("**/*.py", "**/*.pyi")
local ruff_exclude = List(
    "stubs/**",
    "wheel-data/**",
    "python/rithmic_gateway/v1/session_pb2.py",
)

// qlty orchestrates other linters + security scanners (bandit, trufflehog,
// shellcheck, actionlint, zizmor, osv-scanner, clippy, radarlint, smells).
// Per-file on the pre-commit hook so hk's git stash is the source of truth.
// Whole-project on `check` is delegated to the `qlty-check` step below, which
// matches the CI PR gate (changed files vs the merge base).
local qlty_globs = List(
    "**/*.py",
    "**/*.pyi",
    "**/*.rs",
    "**/*.toml",
    "**/*.sh",
    "**/*.yml",
    "**/*.yaml",
)
local qlty_exclude = List(
    "stubs/**",
    "wheel-data/**",
    "target/**",
    ".venv/**",
    ".qlty/**",
    "python/rithmic_gateway/v1/**",
)

local rinters = new Mapping<String, Step> {
    ["ruff-format"] {
        glob = ruff_globs
        exclude = ruff_exclude
        check = "uv run ruff format --check {{files}}"
        fix = "uv run ruff format {{files}}"
    }
    ["ruff"] {
        glob = ruff_globs
        exclude = ruff_exclude
        check = "uv run ruff check {{files}}"
        fix = "uv run ruff check --fix {{files}}"
    }
    ["cargo-fmt"] = (Builtins.cargo_fmt) {
        check = "cargo fmt --check -- {{files}}"
        fix = "cargo fmt -- {{files}}"
    }
    ["qlty"] {
        glob = qlty_globs
        exclude = qlty_exclude
        check = "qlty check --filter=clippy,ruff,bandit,shellcheck,actionlint,zizmor -- {{files}}"
        // qlty's --fix applies AI/autofixes (qltysh generated); we keep hk's
        // own autofix steps as the only mutator of the working tree on hooks
        // so a single owner decides what --fix means across the toolchain.
        fix = "qlty fmt -- {{files}}"
    }
}

// Rust lint/check steps. Unlike the Python linters these run whole-workspace
// (clippy cannot lint a per-file subset), mirroring how `ty` is run project-wide.
local rust_checks = new Mapping<String, Step> {
    // `cargo clippy -D warnings` is the Rust analog of `ruff check`: catches
    // real bug patterns the compiler allows. `-D warnings` fails the gate on
    // any warning, including in tests/benches (--all-targets).
    ["cargo-clippy"] {
        check = "cargo clippy --workspace --all-targets -- -D warnings"
    }
}

local linters = new Mapping<String, Step> {
    ...rinters
}

hooks {
    // Fix and re-stage staged files before committing.
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    // Project-wide gate mirroring CI (ty/clippy/qlty are run whole-project,
    // not per-file). Includes the Rust test suite so a local `hk run check`
    // matches CI exactly.
    ["check"] {
        steps {
            ...linters
            ...rust_checks
            ["ty"] {
                check = "uv run ty check python/rithmic_nt_connect tests"
            }
            // Python test gate (matches the CI `pytest` step).
            ["pytest"] {
                check = "uv run pytest -q"
            }
            // qlty mirrors the CI PR gate. Defaults to changed files vs the
            // merge base (no `--all`), so pre-existing smells are
            // grandfathered while NEW findings fail. `--fail-level=medium`
            // matches CI so fmt-level nits (whitespace, import order) do not
            // block, while medium+ findings (security, complexity,
            // duplication, smells) block. Use `qlty check --all` against the
            // current branch to see the full baseline.
            ["qlty-check"] {
                check = "qlty check --fail-level=medium"
            }
            // Whole-workspace test gate (matches the CI `cargo test` step).
            // `python` feature is empty-default so this never links libpython.
            ["cargo-test"] {
                check = "cargo test --workspace"
            }
            // Docs guard: STATUS.md scoreboard must match its own [x]/[~]/[ ] marks.
            // Pure-stdlib; no venv needed.
            ["status-progress"] {
                check = "python scripts/status_progress.py --check"
            }
        }
    }
}

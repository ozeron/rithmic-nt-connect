# Required
RITHMIC_USER=
RITHMIC_PASSWORD=

# How this process opens Rithmic (required; no default)
#   direct  — this process takes the credential flock + opens plants (PyO3)
#   gateway — dial rithmic-gateway over unix://… (shared login; no local plants)
RITHMIC_CONNECT_MODE=direct

# Test plant (python scripts/list_systems.py)
RITHMIC_SYSTEM_NAME=Rithmic Test
RITHMIC_GATEWAY=wss://rituz00100.rithmic.com:443
# production: LucidTrading / wss://rprotocol.rithmic.com:443

# Optional — smoke defaults to NQ / CME
# RITHMIC_SYMBOL=NQ
# RITHMIC_EXCHANGE=CME

# Optional account routing (auto-discovered from order-plant login when unset).
# Full triple overrides discovery. With multiple accounts, set ACCOUNT_ID only as selector.
# RITHMIC_ACCOUNT_ID=
# RITHMIC_FCM_ID=
# RITHMIC_IB_ID=

# Gateway only (when RITHMIC_CONNECT_MODE=gateway)
# RITHMIC_GATEWAY_LISTEN=unix:///run/user/$UID/rithmic-gateway-<hash>.sock
# RITHMIC_GATEWAY_AUTO_SPAWN=1
# RITHMIC_GATEWAY_BIN=…
# RITHMIC_GATEWAY_AUTH_TOKEN=
# RITHMIC_GATEWAY_IDLE_EXIT_SEC=5

# LucidTrading / R|Protocol (never commit real values)
#
# Prefer MY046-style names for LucidTrading acceptance, or rithmic-rs Live/Demo
# prefixes. SessionConfig maps LucidTrading to Live env + system LucidTrading +
# the production gateway URL below.

# --- MY046 / LucidTrading style ---
RITHMIC_USER=
RITHMIC_PASSWORD=
RITHMIC_SYSTEM=LucidTrading
RITHMIC_GATEWAY=wss://rprotocol.rithmic.com:443
RITHMIC_APP_NAME=rithmic-connect
RITHMIC_APP_VERSION=0.1.0

# Optional — PnL / account routing (also accepted as ACCOUNT_ID / FCM_ID / IB_ID)
# RITHMIC_ACCOUNT_ID=
# RITHMIC_FCM_ID=
# RITHMIC_IB_ID=

# Phase 1 acceptance defaults
RITHMIC_SYMBOL=NQ
RITHMIC_EXCHANGE=CME

# --- rithmic-rs Live style (alternative to MY046 names) ---
# RITHMIC_LIVE_USER=
# RITHMIC_LIVE_PW=
# RITHMIC_LIVE_URL=wss://rprotocol.rithmic.com:443
# RITHMIC_LIVE_ALT_URL=wss://rprotocol.rithmic.com:443
# RITHMIC_LIVE_SYSTEM_NAME=LucidTrading
# RITHMIC_LIVE_ACCOUNT_ID=
# RITHMIC_LIVE_FCM_ID=
# RITHMIC_LIVE_IB_ID=

# --- rithmic-rs Demo style ---
# RITHMIC_DEMO_USER=
# RITHMIC_DEMO_PW=
# RITHMIC_DEMO_URL=
# RITHMIC_DEMO_ALT_URL=
# RITHMIC_DEMO_SYSTEM_NAME=Rithmic Paper Trading
# RITHMIC_DEMO_ACCOUNT_ID=
# RITHMIC_DEMO_FCM_ID=
# RITHMIC_DEMO_IB_ID=
